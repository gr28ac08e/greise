---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathFor } from '../lib/utils';
const envoye = Astro.url.searchParams.get('envoye') === '1';
---

<BaseLayout title="Contact | Greise" description="Une question, une correction, une suggestion ? Écrivez à la rédaction de Greise via notre formulaire de contact." canonicalPath="/contact/">
  <div class="container contact-page">
    <header class="page-head">
      <p class="eyebrow">Écrivez-nous</p>
      <h1>Contactez la rédaction</h1>
      <p class="page-intro">
        Une question sur un article, une correction à signaler, une suggestion de sujet ou une demande de partenariat ? Nous lisons tout et répondons sous 48 heures ouvrées. Vous pouvez aussi nous écrire directement à <a href="mailto:greise013@gmail.com">greise013@gmail.com</a>.
      </p>
    </header>

    {envoye && (
      <div class="contact-success" role="status">
        <strong>Merci, votre message est bien parti !</strong>
        <p>Nous vous répondrons à l'adresse indiquée sous 48 heures ouvrées. À très vite sur Greise.</p>
      </div>
    )}

    <div class="contact-grid">
      <section class="contact-card" aria-labelledby="form-title">
        <h2 id="form-title">Votre message</h2>
        <form
          class="contact-form"
          target="_blank"
          action="https://formsubmit.co/greise013@gmail.com"
          method="POST"
        >
          <input type="hidden" name="_subject" value="Nouveau message depuis le site Greise" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_next" value="https://gr28ac08e.github.io/greise/contact/?envoye=1" />

          <div class="form-row-2">
            <div class="form-field">
              <label for="contact-name">Votre nom</label>
              <input type="text" id="contact-name" name="name" required placeholder="Ex. : Amina K." autocomplete="name" />
            </div>
            <div class="form-field">
              <label for="contact-email">Votre adresse email</label>
              <input type="email" id="contact-email" name="email" required placeholder="vous@exemple.com" autocomplete="email" />
            </div>
          </div>

          <div class="form-field">
            <label for="contact-subject">Sujet</label>
            <select id="contact-subject" name="sujet">
              <option value="Question sur un article">Question sur un article</option>
              <option value="Correction à signaler">Correction à signaler</option>
              <option value="Suggestion de sujet">Suggestion de sujet</option>
              <option value="Partenariat / publicité">Partenariat / publicité</option>
              <option value="Autre">Autre</option>
            </select>
          </div>

          <div class="form-field">
            <label for="contact-message">Votre message</label>
            <textarea id="contact-message" name="message" rows="8" required placeholder="Écrivez votre message ici…"></textarea>
          </div>

          <button class="button button-primary" type="submit">Envoyer le message</button>
          <p class="meta">En envoyant ce formulaire, vous acceptez que votre message et votre adresse email soient transmis à la rédaction de Greise pour vous répondre.</p>
        </form>
      </section>

      <aside class="contact-side">
        <div class="contact-info-card">
          <h2>Autres moyens de nous joindre</h2>
          <ul class="contact-list">
            <li>
              <span class="contact-label">Email</span>
              <a href="mailto:greise013@gmail.com">greise013@gmail.com</a>
            </li>
            <li>
              <span class="contact-label">TikTok</span>
              <a href="https://www.tiktok.com/@gresie13" target="_blank" rel="noopener noreferrer">@gresie13</a>
            </li>
            <li>
              <span class="contact-label">Facebook</span>
              <a href="https://www.facebook.com/profile.php?id=61590273613236" target="_blank" rel="noopener noreferrer">Greise — page officielle</a>
            </li>
          </ul>
        </div>
        <div class="contact-info-card">
          <h2>Avant d'écrire</h2>
          <p>La réponse à votre question se trouve peut-être déjà sur le site :</p>
          <ul class="contact-list">
            <li><a href={pathFor('/a-propos/')}>Notre démarche et notre méthode de vérification</a></li>
            <li><a href={pathFor('/politique-editoriale/')}>Notre politique éditoriale</a></li>
            <li><a href={pathFor('/abonnement/')}>S'abonner à la lettre quotidienne</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
