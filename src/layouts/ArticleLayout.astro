---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Comments from '../components/Comments.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categoryLabel, coverageLabel, outletCount, outletNames, pathFor, readingTime, storySources } from '../lib/utils';
const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;
const [editorial, rss] = await Promise.all([getCollection('articles'), getCollection('rssArticles')]);
const related = [...editorial, ...rss].filter((item) => item.id !== article.id && item.data.category === data.category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const spoken = `${data.title}. ${data.summary} ${data.whyItMatters} ${article.body || ''}`;
const href = new URL(pathFor(`/article/${article.id}/`), Astro.site).toString();
const image = data.imageUrl || data.image;
const isRssPhoto = Boolean(data.imageUrl);
const imageAlt = isRssPhoto
  ? `Photo associée à l'article : ${data.title}`
  : `Illustration éditoriale de la rubrique ${categoryLabel(data.category)}`;
const formattedDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(data.updatedDate || data.pubDate);
const isStory = data.kind !== 'repère';
const sources = storySources(data);
const count = outletCount(data);
const coverage = coverageLabel(data);
const hasBody = Boolean(article.body && article.body.trim());
const excerptRef = sources.find((ref) => ref.excerpt);
const stamp = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const imageCredit = data.imageCredit || data.source;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isStory ? 'NewsArticle' : 'Article',
  headline: data.title,
  description: data.summary,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate || data.pubDate).toISOString(),
  inLanguage: 'fr',
  mainEntityOfPage: href,
  author: { '@type': 'Organization', name: 'Greise' },
  publisher: { '@type': 'Organization', name: 'Greise' },
  ...(isStory && sources.length ? { isBasedOn: sources.map((ref) => ({ '@type': 'NewsArticle', url: ref.url, name: ref.title || data.title, publisher: { '@type': 'Organization', name: ref.name } })) } : {}),
};
---
<BaseLayout title={`${data.title} | Greise`} description={data.summary} image={image} type="article" canonicalPath={`/article/${article.id}/`} jsonLd={jsonLd}>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
  <article class="container article-page">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href={pathFor('/')}>Accueil</a>
      <span aria-hidden="true">/</span>
      <a href={pathFor(`/categorie/${data.category}/`)}>{categoryLabel(data.category)}</a>
    </nav>

    <header class="article-head">
      <p class="eyebrow">{isStory ? coverage : 'Dossier de repères'}</p>
      <h1>{data.title}</h1>
      <p class="article-deck">{data.summary}</p>
      {isStory && data.generatedBy === 'ai' && <p class="deck-origin">Synthèse rédigée par Greise, avec l'aide d'un outil d'IA, à partir des titres et extraits de {outletNames(data)}. Elle peut contenir des erreurs : vérifiez dans les sources.</p>}
      {isStory && data.generatedBy !== 'ai' && excerptRef && <p class="deck-origin">Extrait publié par {excerptRef.name} (éventuellement raccourci), non réécrit par Greise.</p>}
      <div class="article-byline meta">
        <span>{isStory ? `Sujet suivi par Greise` : 'Rédaction Greise'}</span><span aria-hidden="true">·</span>
        <time datetime={(data.updatedDate || data.pubDate).toISOString()}>{isStory ? 'Mis à jour le ' : ''}{formattedDate}</time><span aria-hidden="true">·</span>
        <span>{readingTime(spoken)} min de lecture</span>
      </div>
    </header>

    <div class="article-tools-row"><span class="article-kicker">GREISE · {isStory ? 'ACTUALITÉ RECOUPÉE' : 'REPÈRES'}</span><span class="article-reading-time">{readingTime(spoken)} min de lecture</span></div>
    <figure class="article-photo">
      <img class="article-hero-image" src={image} alt={imageAlt} width="1200" height="675" fetchpriority="high" />
      <figcaption class="image-credit">
        {isRssPhoto
          ? `Photo : ${imageCredit}, média source de l'article. Greise ne détient pas les droits de cette image.`
          : `Illustration éditoriale de la rubrique ${categoryLabel(data.category)}.`}
      </figcaption>
    </figure>

    <div class="article-sticky-audio"><AudioPlayer text={spoken} slug={article.id} /></div>

    {data.whyItMatters && (
      <aside class="article-importance" aria-labelledby="importance-title">
        <h2 id="importance-title">{isStory ? 'À retenir' : 'Le contexte, en bref'}</h2>
        <p>{data.whyItMatters}</p>
      </aside>
    )}

    {hasBody && <div class="article-body"><Content /></div>}

    {isStory ? (
      <section class="source-box coverage-box" aria-labelledby="source-title">
        <h2 id="source-title">Ce que disent les sources</h2>
        <p class="coverage-lead">
          {count > 1
            ? <>Ce sujet est traité par <strong>{count} médias</strong> : {outletNames(data, 6)}. Greise les rapproche et renvoie vers chaque article.</>
            : <>Pour l'instant, <strong>un seul média</strong> ({outletNames(data)}) rapporte cette information. Elle n'est pas encore recoupée : à confirmer.</>}
        </p>
        <ol class="source-list">
          {sources.map((ref, index) => (
            <li class="source-entry">
              <div class="source-entry-head">
                <strong>{ref.name}</strong>
                {ref.pubDate && <time datetime={ref.pubDate.toISOString()}>{stamp.format(ref.pubDate)} UTC</time>}
                {index === 0 && count > 1 && <span class="source-first">Premier à publier</span>}
              </div>
              <a class="source-entry-title" href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title || data.title} ↗</a>
              {ref.excerpt && <blockquote class="source-excerpt">{ref.excerpt}</blockquote>}
            </li>
          ))}
        </ol>
        <p class="meta">Les titres et extraits appartiennent à leurs éditeurs. Seuls les articles originaux font foi : consultez-les pour le texte intégral et les mises à jour.</p>
      </section>
    ) : (
      <section class="source-box" aria-labelledby="source-title">
        <h2 id="source-title">Sources &amp; transparence</h2>
        <p>Dossier de repères rédigé par Greise. Il explique un mécanisme et ne rapporte pas l'actualité du jour. Pour un fait précis, remontez au document ou à l'institution d'origine.</p>
      </section>
    )}

    <section class="article-end-note"><span class="article-end-rule"></span><p>{isStory ? <>Greise <strong>rassemble et recoupe</strong> l'actualité publiée par d'autres médias. Les articles originaux restent la référence.</> : <>Un dossier de repères de <strong>Greise</strong>. Comprendre le monde, au-delà des titres.</>}</p></section>

    <div class="share-row" aria-label="Partager cet article">
      <a class="button" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(href)}`} target="_blank" rel="noopener noreferrer">Partager sur Facebook</a>
      <a class="button" href="https://tiktok.com/@gresie13" target="_blank" rel="noopener noreferrer">Suivre Greise sur TikTok</a>
      <a class="button" href={pathFor('/flux-rss/')}>Flux RSS Greise</a>
      <button class="button" type="button" data-share hidden data-share-title={data.title} data-share-url={href}>Partager…</button>
      <button class="button" type="button" data-copy-link={href}>Copier le lien</button>
      <span class="copy-status" aria-live="polite"></span>
    </div>

    {related.length > 0 && <section class="related-section" aria-labelledby="related-title"><div class="related-heading"><p class="eyebrow">Pour approfondir</p><h2 id="related-title">À lire aussi</h2></div><div class="related-list">{related.map((item) => <ArticleCard article={item} />)}</div></section>}

    <section class="comments-section" aria-labelledby="comments-title">
      <h2 id="comments-title">Espace débat : réagissez à cet article</h2>
      <p class="comments-note">
        Une simple adresse email suffit : vous recevez un lien de connexion, sans mot de passe, pour commenter et réagir aux commentaires. Les échanges sont modérés dans le respect de notre <a href={pathFor('/politique-editoriale/')}>politique éditoriale</a>.
      </p>
      <Comments slug={article.id} />
    </section>

    <script>
      const progressBar = document.querySelector<HTMLElement>('#reading-progress-bar');
      const updateReadingProgress = () => { const article = document.querySelector<HTMLElement>('.article-page'); if (!article || !progressBar) return; const rect = article.getBoundingClientRect(); const total = article.offsetHeight - window.innerHeight; const passed = Math.min(1, Math.max(0, -rect.top / Math.max(1, total))); progressBar.style.transform = `scaleX(${passed})`; };
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      updateReadingProgress();
      document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
        if (!navigator.share) return;
        button.hidden = false;
        button.addEventListener('click', () => { navigator.share({ title: button.dataset.shareTitle || document.title, url: button.dataset.shareUrl || location.href }).catch(() => {}); });
      });
      document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
        button.addEventListener('click', async () => {
          const status = button.parentElement?.querySelector<HTMLElement>('.copy-status');
          try { await navigator.clipboard.writeText(button.dataset.copyLink || location.href); if (status) status.textContent = 'Lien copié.'; }
          catch { if (status) status.textContent = 'Copiez l’adresse depuis la barre du navigateur.'; }
        });
      });
    </script>
  </article>
</BaseLayout>
