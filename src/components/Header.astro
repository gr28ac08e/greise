---
import { categories, pathFor } from '../lib/utils';
import SocialLinks from './SocialLinks.astro';
const norm = (p: string) => p.replace(/\/+$/, '');
const here = norm(Astro.url.pathname);
const base = norm(import.meta.env.BASE_URL);
const isHome = here === base || here === '';
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---
<header class="greise-header">
  <div class="container greise-masthead">
    <a class="greise-brand" href={pathFor('/')} aria-label="Greise, accueil">
      <img src={pathFor('/logo.svg')} alt="" width="250" height="58" />
      <span class="greise-brand-caption">ACTUALITÉS &amp; ANALYSES</span>
    </a>
    <div class="greise-promise">
      <span class="promise-globe" aria-hidden="true">◎</span>
      <span>Média d'actualité internationale, sans frontières —<br /><em>visible et écoutable</em></span>
    </div>
    <div class="greise-tools">
      <div class="greise-social"><SocialLinks compact={true} /></div>
      <span class="greise-tool-divider" aria-hidden="true"></span>
      <div class="font-controls" role="group" aria-label="Taille du texte">
        <button type="button" data-fontsize="normal" aria-pressed="true" aria-label="Taille normale">A</button>
        <button type="button" data-fontsize="large" aria-pressed="false" aria-label="Texte agrandi">A+</button>
        <button type="button" data-fontsize="xl" aria-pressed="false" aria-label="Texte très agrandi">A++</button>
      </div>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="Changer le thème" title="Changer le thème">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
      </button>
      <a class="greise-subscribe" href={pathFor('/abonnement/#newsletter')}>♧ S'abonner</a>
    </div>
  </div>
  <nav class="edition-nav" aria-label="Navigation principale">
    <div class="container edition-inner">
      <div class="edition-links">
        <a href={pathFor('/')} aria-current={isHome ? 'page' : undefined}>
          <svg class="icon nav-home-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"/></svg>
          Accueil
        </a>
        {categories.map((category) => (
          <a href={pathFor(`/categorie/${category.slug}/`)} aria-current={current.includes(`/categorie/${category.slug}`) ? 'page' : undefined}>{category.label}</a>
        ))}
        <a href={pathFor('/a-propos/')}>Analyses</a>
      </div>
      <div class="edition-side">
        <a href={pathFor('/a-propos/')}>Notre démarche</a>
        <a class="subscribe" href={pathFor('/abonnement/#connexion')}>Se connecter</a>
      </div>
      <button class="eco-toggle" id="eco-toggle" type="button" aria-pressed="false" title="Réduire les images et les effets pour les connexions lentes">Éco-mode</button>
    </div>
  </nav>
</header>
