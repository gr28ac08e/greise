---
import { BACKEND, backendConfigured } from '../lib/backend';
import { pathFor } from '../lib/utils';
interface Props { slug: string }
const { slug } = Astro.props;
const configured = backendConfigured();
---
<div
  class="comments-app"
  data-comments
  data-slug={slug}
  data-configured={String(configured)}
  data-url={BACKEND.url}
  data-key={BACKEND.anonKey}
>
  <div data-auth></div>
  <form class="comments-form" id="comment-composer" data-form>
    <label class="comments-label" for="comment-input">Ajouter un commentaire</label>
    <textarea
      id="comment-input"
      data-input
      rows="3"
      maxlength="2000"
      required
      placeholder="Réagissez avec courtoisie et des arguments sourcés…"></textarea>
    <div class="comments-form-actions">
      <button class="button button-primary" type="submit">Publier</button>
      <span class="comments-note" data-status aria-live="polite"></span>
    </div>
  </form>
  <p class="comments-note" data-global-status aria-live="polite"></p>
  <div class="comments-list" data-list>
    <p class="comments-note">Chargement des commentaires…</p>
  </div>
  <noscript>
    <p class="comments-note">Les commentaires nécessitent JavaScript.</p>
  </noscript>
</div>

<script is:inline src={pathFor('/comments.js')} defer></script>
