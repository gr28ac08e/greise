---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { categories, categoryLabel, pathFor, readingTime } from '../lib/utils';

const [editorial, rss] = await Promise.all([getCollection('articles'), getCollection('rssArticles')]);
const newest = [...editorial, ...rss].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const withPhotos = newest.filter((article) => Boolean(article.data.imageUrl));
const leadStories = Array.from(new Map([...withPhotos, ...newest].map((article) => [article.id, article])).values()).slice(0, 4);
const lead = leadStories[0] || newest[0];
const selectedIds = new Set(leadStories.map((article) => article.id));
const shown = newest;
const imageFor = (article: (typeof newest)[number]) => article.data.imageUrl || pathFor(article.data.image || '/images/repere.svg');
const spokenFor = (article: (typeof newest)[number]) => `${article.data.title}. ${article.data.summary} ${article.data.whyItMatters} ${article.body || ''}`;
const audioFor = (article: (typeof newest)[number]) => existsSync(resolve(process.cwd(), 'public', 'audio', `${article.id}.mp3`)) ? pathFor(`/audio/${article.id}.mp3`) : '';
const readMinutesFor = (article: (typeof newest)[number]) => readingTime(spokenFor(article));
const leadImage = lead ? imageFor(lead) : '';
const leadHref = lead ? pathFor(`/article/${lead.id}/`) : '';
const leadDate = lead ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(lead.data.pubDate) : '';
const leadAlt = lead ? (lead.data.imageUrl ? `Photo liée à l'article : ${lead.data.title}` : `Illustration de la rubrique ${categoryLabel(lead.data.category)}`) : '';
const nextStory = newest.find((article) => !selectedIds.has(article.id));
const feed = leadStories.slice(1, 4).map((article) => ({
  time: `${readMinutesFor(article)} min de lecture`,
  category: categoryLabel(article.data.category),
  title: article.data.title,
  summary: article.data.summary,
  source: article.data.source,
  credit: article.data.imageUrl ? `Photo : ${article.data.source}, via son flux RSS` : '',
  image: imageFor(article),
  href: pathFor(`/article/${article.id}/`),
}));
---

<BaseLayout title="Greise | L'actualité mondiale, lisible et écoutable" description="L'actualité internationale en français, contextualisée et écoutable. Des résumés sourcés, des repères et une lecture claire, gratuitement." image={leadImage || '/avatar.jpg'}>
  {lead ? (
    <section class="container hero-grid" aria-label="À la une">
      <div class="lead-column">
        <article class="lead-card" aria-labelledby="lead-title">
          <a class="lead-figure" id="lead-image-link" href={leadHref} aria-label={`Ouvrir l'article : ${lead.data.title}`}>
            <img id="lead-image" src={leadImage} alt={leadAlt} width="1200" height="675" fetchpriority="high" />
            <span class="lead-pill" id="lead-category">{categoryLabel(lead.data.category)}</span>
            <span class="lead-source-badge">
              <svg class="icon" style="width:.8rem;height:.8rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span id="lead-source-badge-text">{lead.data.source}</span>
            </span>
            {lead.data.imageUrl && <span class="lead-credit" id="lead-credit">Photo : {lead.data.source}, via son flux RSS</span>}
          </a>
          <div class="lead-body">
            <div class="lead-meta">
              <span>Par <strong id="lead-source">{lead.data.source}</strong></span>
              <span><time id="lead-date" datetime={lead.data.pubDate.toISOString()}>{leadDate}</time> · <span id="lead-reading-time">{readMinutesFor(lead)}</span> min de lecture</span>
            </div>
            <h1 class="lead-title" id="lead-title"><a id="lead-title-link" href={leadHref}>{lead.data.title}</a></h1>
            <p class="lead-deck" id="lead-summary">{lead.data.summary}</p>
            <p class="lead-why" id="lead-why"><strong>Pourquoi c'est important</strong>{lead.data.whyItMatters}</p>
            <div class="lead-actions">
              <div id="lead-audio-wrapper"><AudioPlayer text={spokenFor(lead)} slug={lead.id} label="Écouter l'article" /></div>
              <button class="button" type="button" data-sources-open>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                Transparence &amp; sources
              </button>
            </div>
            {leadStories.length > 1 && (
              <div class="lead-pagination" role="group" aria-label="Choisir l'article à la une">
                {leadStories.map((story, index) => (
                  <button
                    class:list={['lead-page-button', index === 0 && 'is-active']}
                    type="button"
                    aria-label={`Afficher l'article ${index + 1} : ${story.data.title}`}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-lead-slide
                    data-title={story.data.title}
                    data-summary={story.data.summary}
                    data-why={story.data.whyItMatters}
                    data-source={story.data.source}
                    data-category={categoryLabel(story.data.category)}
                    data-href={pathFor(`/article/${story.id}/`)}
                    data-image={imageFor(story)}
                    data-alt={story.data.imageUrl ? `Photo liée à l'article : ${story.data.title}` : `Illustration de la rubrique ${categoryLabel(story.data.category)}`}
                    data-date={story.data.pubDate.toISOString()}
                    data-date-label={new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(story.data.pubDate)}
                    data-reading-time={readMinutesFor(story)}
                    data-audio-text={spokenFor(story)}
                    data-audio-src={audioFor(story) || undefined}
                    data-source-url={story.data.sourceUrl || ''}
                    data-credit={story.data.imageUrl ? `Photo : ${story.data.source}, via son flux RSS` : ''}
                  >{index + 1}</button>
                ))}
              </div>
            )}
          </div>
        </article>

        {nextStory && (
          <section class="next-story" aria-labelledby="next-story-title">
            <p class="next-story-label">À SUIVRE</p>
            <a class="next-story-card" href={pathFor(`/article/${nextStory.id}/`)}>
              <span class="next-story-photo"><img src={imageFor(nextStory)} alt="" width="240" height="150" loading="lazy" /></span>
              <span class="next-story-copy">
                <span class="next-story-category">{categoryLabel(nextStory.data.category)}</span>
                <strong id="next-story-title">{nextStory.data.title}</strong>
                <span class="next-story-meta">{readMinutesFor(nextStory)} min de lecture · {nextStory.data.source}</span>
                {nextStory.data.imageUrl && <span class="next-story-credit">Photo : {nextStory.data.source}</span>}
              </span>
            </a>
          </section>
        )}
      </div>

      <aside class="home-side">
        <div class="live-panel">
          <div class="live-panel-head">
            <h2><span class="live-dot-big" aria-hidden="true"></span>À la une aussi</h2>
            <span>Greise</span>
          </div>
          <div class="live-items">
            {feed.length ? feed.map((item, index) => (
              <article class:list={['live-item', index === 0 ? 'live-featured' : 'live-compact']}>
                <a class="live-thumb" href={item.href} aria-label={item.title}><img src={item.image} alt="" width="640" height="360" loading="lazy" decoding="async" /></a>
                <div class="live-copy">
                  <div class="live-item-top"><span class="live-time">{item.time}</span><span class="live-chip">{item.category}</span></div>
                  <a class="live-title" href={item.href}>{item.title}</a>
                  <p class="live-context">{item.summary}</p>
                  {item.credit && <span class="live-credit">{item.credit}</span>}
                </div>
              </article>
            )) : <p class="live-title">Les prochains articles arriveront bientôt.</p>}
          </div>
          <a class="live-more" href="#tous-les-articles">
            Voir toute l'actualité
            <svg class="icon" style="width:.85rem;height:.85rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      </aside>
    </section>

    <dialog class="sources-modal" id="sources-modal" aria-labelledby="sources-title">
      <div class="sources-head">
        <h2 id="sources-title">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          Transparence &amp; sources
        </h2>
        <button class="icon-button" type="button" data-sources-close aria-label="Fermer la fiche"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      </div>
      <p class="sources-article" id="sources-article">Article : {lead.data.title}</p>
      <div class="sources-method"><strong>Méthodologie de vérification</strong><p>Les actualités de Greise sont des résumés et contextualisations produits à partir des titres et extraits fournis par les flux RSS des médias sources. Chaque article renvoie à sa publication d'origine ; les dossiers de repères sont préparés et identifiés par la rédaction.</p></div>
      <span class="sources-label">Source primaire référencée</span>
      <div class="source-item"><span id="sources-source">{lead.data.source}</span><span class="source-type">Média source</span></div>
      <a class="sources-link" id="sources-original-link" href={lead.data.sourceUrl || '#'} target="_blank" rel="noopener noreferrer" hidden={!lead.data.sourceUrl}>Consulter l'article original publié par {lead.data.source} ↗</a>
      <button class="button button-primary sources-close" type="button" data-sources-close>Fermer la fiche</button>
    </dialog>
  ) : (
    <section class="container section"><div class="empty-state">Les prochains articles arriveront bientôt. Revenez nous lire.</div></section>
  )}

  <section class="container section recommended-section" aria-labelledby="recommended-title" data-recommended-section hidden>
    <div class="section-heading"><h2 id="recommended-title">Pour vous</h2><p>Une sélection construite à partir des rubriques que vous suivez.</p></div>
    <div class="recommended-list" data-recommended-list></div>
    <p class="recommended-empty" data-recommended-empty>Suivez une rubrique depuis une carte d'actualité pour personnaliser votre fil.</p>
  </section>

  <section class="container section" id="tous-les-articles" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">Dernières actualités</h2><p id="latest-description">Le monde en contexte, une publication après l'autre.</p></div>
    <nav class="category-bar" aria-label="Filtrer par catégorie">
      <a href={pathFor('/')} aria-current="page">Tout</a>
      {categories.map((category) => <a href={pathFor(`/categorie/${category.slug}/`)}>{category.label}</a>)}
    </nav>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    {shown.length ? (
      <div class="article-list" id="article-grid">
        {shown.map((article, index) => <div class="article-grid-item" data-page-item data-index={index} data-lead-duplicate={article.id === lead?.id ? 'true' : undefined}><ArticleCard article={article} /></div>)}
      </div>
    ) : <div class="empty-state">Les nouvelles publications de Greise s'afficheront ici.</div>}
    <p class="empty-state search-empty" id="search-empty" hidden>Aucun article ne correspond à votre recherche.</p>
    {shown.length > 6 && <div class="load-more-wrap"><button class="button" type="button" id="load-more">Charger plus</button></div>}
  </section>

  <section class="container section" aria-labelledby="debat-title">
    <div class="debate-panel">
      <div class="debate-head">
        <div class="debate-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div><h2 id="debat-title">L'Espace Débat des Lecteurs</h2><p>Des échanges vérifiés et modérés pour encourager la nuance et le respect réciproque.</p></div>
      </div>
      <div class="debate-card">
        <div class="debate-card-top"><div class="debate-author"><span class="debate-avatar" aria-hidden="true">G</span><div><strong>La rédaction Greise</strong><span class="debate-author-sub">greise013@gmail.com</span></div></div><span class="debate-badge">Contribution constructive</span></div>
        <p class="debate-quote">« Chaque article de Greise renvoie à sa source originale. Créez votre compte lecteur avec votre adresse email pour réagir, apporter un éclairage ou contester avec des arguments. Vos commentaires sont publics et modérés selon notre politique éditoriale. »</p>
      </div>
      <div class="debate-cta"><span>Ouvrez n'importe quel article pour commenter avec votre compte lecteur.</span><a class="button button-primary" href={pathFor('/abonnement/')}>Créer mon compte lecteur</a></div>
    </div>
  </section>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-page-item]'));
    const loadMore = document.querySelector<HTMLButtonElement>('#load-more');
    const searchInput = document.querySelector<HTMLInputElement>('#greise-search');
    const heroGrid = document.querySelector<HTMLElement>('.hero-grid');
    const searchStatus = document.querySelector<HTMLElement>('#search-status');
    const searchEmpty = document.querySelector<HTMLElement>('#search-empty');
    const latestTitle = document.querySelector<HTMLElement>('#latest-title');
    const latestDescription = document.querySelector<HTMLElement>('#latest-description');
    let visible = 6;
    let matchingCards = cards;
    let activeQuery = new URLSearchParams(location.search).get('q')?.trim() || '';
    if (searchInput && activeQuery) searchInput.value = activeQuery;

    const updateCardVisibility = () => {
      cards.forEach((card) => { card.hidden = true; });
      matchingCards.slice(0, visible).forEach((card) => { card.hidden = false; });
      if (loadMore) loadMore.hidden = matchingCards.length <= visible;
      if (searchEmpty) searchEmpty.hidden = matchingCards.length > 0;
    };
    const applySearch = (value = searchInput?.value || '') => {
      activeQuery = value.trim().toLocaleLowerCase('fr');
      matchingCards = cards.filter((card) => {
        if (!activeQuery && card.dataset.leadDuplicate === 'true') return false;
        return !activeQuery || card.innerText.toLocaleLowerCase('fr').includes(activeQuery);
      });
      visible = 6;
      if (heroGrid) heroGrid.hidden = Boolean(activeQuery);
      if (latestTitle) latestTitle.textContent = activeQuery ? `Résultats pour « ${value.trim()} »` : 'Dernières actualités';
      if (latestDescription) latestDescription.textContent = activeQuery ? `${matchingCards.length} résultat${matchingCards.length > 1 ? 's' : ''} dans les publications Greise.` : "Le monde en contexte, une publication après l'autre.";
      if (searchStatus) searchStatus.textContent = activeQuery ? `${matchingCards.length} article${matchingCards.length > 1 ? 's' : ''} trouvé${matchingCards.length > 1 ? 's' : ''}.` : '';
      updateCardVisibility();
    };
    applySearch(activeQuery);
    searchInput?.addEventListener('input', () => applySearch());
    loadMore?.addEventListener('click', () => { visible += 6; updateCardVisibility(); });

    const slides = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lead-slide]'));
    const leadImageElement = document.querySelector<HTMLImageElement>('#lead-image');
    const leadImageLink = document.querySelector<HTMLAnchorElement>('#lead-image-link');
    const leadTitleLink = document.querySelector<HTMLAnchorElement>('#lead-title-link');
    const leadSummary = document.querySelector<HTMLElement>('#lead-summary');
    const leadWhy = document.querySelector<HTMLElement>('#lead-why');
    const leadCategory = document.querySelector<HTMLElement>('#lead-category');
    const leadSource = document.querySelector<HTMLElement>('#lead-source');
    const leadSourceBadge = document.querySelector<HTMLElement>('#lead-source-badge-text');
    const leadDate = document.querySelector<HTMLTimeElement>('#lead-date');
    const leadReadingTime = document.querySelector<HTMLElement>('#lead-reading-time');
    const leadCredit = document.querySelector<HTMLElement>('#lead-credit');
    const leadAudio = document.querySelector<HTMLElement>('#lead-audio-wrapper');
    const sourceArticle = document.querySelector<HTMLElement>('#sources-article');
    const sourceName = document.querySelector<HTMLElement>('#sources-source');
    const sourceLink = document.querySelector<HTMLAnchorElement>('#sources-original-link');
    const showLead = (button: HTMLButtonElement) => {
      const data = button.dataset;
      if (!data.title || !data.href || !data.image) return;
      if (leadImageElement) { leadImageElement.src = data.image; leadImageElement.alt = data.alt || ''; }
      if (leadImageLink) { leadImageLink.href = data.href; leadImageLink.setAttribute('aria-label', `Ouvrir l'article : ${data.title}`); }
      if (leadTitleLink) { leadTitleLink.href = data.href; leadTitleLink.textContent = data.title; }
      if (leadSummary) leadSummary.textContent = data.summary || '';
      if (leadWhy) { const strong = leadWhy.querySelector('strong'); leadWhy.replaceChildren(); if (strong) leadWhy.append(strong); leadWhy.append(document.createTextNode(data.why || '')); }
      if (leadCategory) leadCategory.textContent = data.category || '';
      if (leadSource) leadSource.textContent = data.source || '';
      if (leadSourceBadge) leadSourceBadge.textContent = data.source || '';
      if (leadDate) { leadDate.textContent = data.dateLabel || ''; leadDate.dateTime = data.date || ''; }
      if (leadReadingTime) leadReadingTime.textContent = data.readingTime || '';
      if (leadCredit) { leadCredit.textContent = data.credit || ''; leadCredit.hidden = !data.credit; }
      const audioButton = leadAudio?.querySelector<HTMLButtonElement>('[data-audio]');
      if (audioButton) {
        if (audioButton.dataset.state === 'playing' || audioButton.dataset.state === 'paused') {
          window.speechSynthesis?.cancel();
          const audioFile = leadAudio?.querySelector<HTMLAudioElement>('audio');
          if (audioFile) { audioFile.pause(); audioFile.currentTime = 0; }
          audioButton.dataset.state = 'idle';
          audioButton.setAttribute('aria-pressed', 'false');
        }
        audioButton.dataset.audioText = data.audioText || '';
        if (data.audioSrc) audioButton.dataset.audioSrc = data.audioSrc;
        else delete audioButton.dataset.audioSrc;
        const audioFile = leadAudio?.querySelector<HTMLAudioElement>('audio');
        if (audioFile) {
          if (data.audioSrc) audioFile.src = data.audioSrc;
          else audioFile.removeAttribute('src');
          audioFile.load();
        }
      }
      if (sourceArticle) sourceArticle.textContent = `Article : ${data.title}`;
      if (sourceName) sourceName.textContent = data.source || '';
      if (sourceLink) {
        sourceLink.hidden = !data.sourceUrl;
        sourceLink.href = data.sourceUrl || '#';
        sourceLink.textContent = data.sourceUrl ? `Consulter l'article original publié par ${data.source} ↗` : '';
      }
      slides.forEach((item) => { const selected = item === button; item.classList.toggle('is-active', selected); item.setAttribute('aria-pressed', String(selected)); });
    };
    slides.forEach((slide) => slide.addEventListener('click', () => showLead(slide)));

    const recommendationSection = document.querySelector<HTMLElement>('[data-recommended-section]');
    const recommendationList = document.querySelector<HTMLElement>('[data-recommended-list]');
    const recommendationEmpty = document.querySelector<HTMLElement>('[data-recommended-empty]');
    const renderRecommendations = () => {
      if (!recommendationSection || !recommendationList) return;
      let followed: string[] = [];
      try { followed = JSON.parse(localStorage.getItem('greise-followed-categories') || '[]'); } catch {}
      recommendationSection.hidden = false;
      recommendationList.replaceChildren();
      const matches = Array.from(document.querySelectorAll<HTMLElement>('[data-article-card]')).filter((card) => followed.includes(card.dataset.category || '')).slice(0, 4);
      if (recommendationEmpty) recommendationEmpty.hidden = matches.length > 0;
      matches.forEach((card) => {
        const link = document.createElement('a'); link.className = 'recommended-card'; link.href = card.dataset.href || '#';
        const image = document.createElement('img'); image.src = card.dataset.image || ''; image.alt = ''; image.loading = 'lazy';
        const copy = document.createElement('span'); copy.className = 'recommended-copy';
        const category = document.createElement('small'); category.textContent = card.dataset.category || 'Actualité';
        const title = document.createElement('strong'); title.textContent = card.dataset.title || '';
        const summary = document.createElement('span'); summary.textContent = card.dataset.summary || '';
        copy.append(category, title, summary); link.append(image, copy); recommendationList.append(link);
      });
    };
    renderRecommendations();
    window.addEventListener('greise:preferences-changed', renderRecommendations);

    const modal = document.querySelector<HTMLDialogElement>('#sources-modal');
    document.querySelectorAll<HTMLButtonElement>('[data-sources-open]').forEach((openButton) => openButton.addEventListener('click', () => modal?.showModal()));
    modal?.querySelectorAll<HTMLButtonElement>('[data-sources-close]').forEach((closeButton) => closeButton.addEventListener('click', () => modal?.close()));
    modal?.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
  </script>
</BaseLayout>
