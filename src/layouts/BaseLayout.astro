---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pathFor } from '../lib/utils';
interface Props { title: string; description: string; image?: string; type?: string; canonicalPath?: string; noIndex?: boolean; jsonLd?: Record<string, unknown>; feed?: { title: string; href: string } }
const { title, description, image = '/avatar.jpg', type = 'website', canonicalPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/'), noIndex = false, jsonLd, feed } = Astro.props;
const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const canonical = new URL(pathFor(canonicalPath), Astro.site).toString();
const socialImage = image.startsWith('https://') ? image : new URL(pathFor(image), Astro.site).toString();
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try {
        var t = localStorage.getItem('greise-theme');
        if (t === 'sunset' || t === 'dark') document.documentElement.dataset.theme = t;
        var x = localStorage.getItem('greise-text');
        if (x === 'large' || x === 'xlarge') document.documentElement.dataset.text = x;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content="Greise" />
    <link rel="icon" type="image/png" sizes="192x192" href={pathFor('/favicon.png')} />
    <link rel="manifest" href={pathFor('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={pathFor('/favicon.png')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Greise : l'actualité recoupée" href={pathFor('/rss.xml')} />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Greise" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    <script>
      import { initAudioPlayers } from '../lib/audio';
      initAudioPlayers();
    </script>
    <script is:inline define:vars={{ swUrl: pathFor('/sw.js'), scope: pathFor('/') }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', function () { navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {}); });
      }
    </script>
  </body>
</html>
