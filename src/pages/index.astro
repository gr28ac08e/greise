---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { BACKEND, backendConfigured } from '../lib/backend';
import { categoryLabel, coverageLabel, emphasizeParts, outletCount, outletNames, pathFor, readingTime, storySources } from '../lib/utils';

const [editorial, rss] = await Promise.all([getCollection('articles'), getCollection('rssArticles')]);
const dateOf = (article: { data: { pubDate: Date; updatedDate?: Date } }) => (article.data.updatedDate || article.data.pubDate).valueOf();
const newest = [...editorial, ...rss].sort((a, b) => dateOf(b) - dateOf(a));
// La une privilégie les sujets recoupés par plusieurs médias (puis les plus récents), avec photo si possible.
const byCoverage = [...newest.slice(0, 16)].sort((a, b) => outletCount(b.data) - outletCount(a.data) || dateOf(b) - dateOf(a));
const withPhotos = byCoverage.filter((article) => Boolean(article.data.imageUrl));
const leadStories = Array.from(new Map([...withPhotos, ...byCoverage, ...newest].map((article) => [article.id, article])).values()).slice(0, 4);
const lead = leadStories[0] || newest[0];
const selectedIds = new Set(leadStories.map((article) => article.id));
const shown = newest;
const imageFor = (article: (typeof newest)[number]) => article.data.imageUrl || pathFor(article.data.image || '/images/repere.svg');
const spokenFor = (article: (typeof newest)[number]) => `${article.data.title}. ${article.data.summary} ${article.data.whyItMatters} ${article.body || ''}`;
const audioFor = (article: (typeof newest)[number]) => existsSync(resolve(process.cwd(), 'public', 'audio', `${article.id}.mp3`)) ? pathFor(`/audio/${article.id}.mp3`) : '';
const readMinutesFor = (article: (typeof newest)[number]) => readingTime(spokenFor(article));
const leadImage = lead ? imageFor(lead) : '';
const leadParts = lead ? emphasizeParts(lead.data.title) : { before: '', word: '', after: '' };
const leadHref = lead ? pathFor(`/article/${lead.id}/`) : '';
const leadDate = lead ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(lead.data.updatedDate || lead.data.pubDate) : '';
const creditFor = (article: (typeof newest)[number]) => (article.data.imageUrl ? `Photo : ${article.data.imageCredit || article.data.source}` : '');
const sourcesJson = (article: (typeof newest)[number]) => JSON.stringify(storySources(article.data).map((ref) => ({ name: ref.name, url: ref.url, title: ref.title || article.data.title })));
const leadAlt = lead ? (lead.data.imageUrl ? `Photo liée à l'article : ${lead.data.title}` : `Illustration de la rubrique ${categoryLabel(lead.data.category)}`) : '';
const liveStories = newest.filter((article) => article.data.kind !== 'repère').slice(0, 10);
const clock = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const dayClock = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const builtAt = clock.format(new Date());
const configured = backendConfigured();
const nextStory = newest.find((article) => !selectedIds.has(article.id));
const feed = leadStories.slice(1, 4).map((article) => ({
  time: `${readMinutesFor(article)} min de lecture · ${coverageLabel(article.data)}`,
  category: categoryLabel(article.data.category),
  title: article.data.title,
  summary: article.data.summary,
  credit: creditFor(article),
  image: imageFor(article),
  href: pathFor(`/article/${article.id}/`),
}));
---

<BaseLayout title="Greise | L'actualité recoupée, avec ses sources" description="L'actualité du monde, recoupée entre plusieurs médias, avec un lien vers chaque source. En français, à lire ou à écouter, gratuitement." image={leadImage || '/avatar.jpg'}>
  {lead ? (
    <section class="container hero-grid hero-stage" aria-label="À la une">
      <a class="lead-figure" id="lead-image-link" href={leadHref} aria-label={`Ouvrir l'article : ${lead.data.title}`} tabindex="-1">
        <img id="lead-image" src={leadImage} alt={leadAlt} width="1200" height="675" fetchpriority="high" />
        {lead.data.imageUrl && <span class="lead-credit" id="lead-credit">{creditFor(lead)}</span>}
      </a>

      <div class="lead-column">
        <article class="lead-card" aria-labelledby="lead-title">
          <div class="lead-body">
            <p class="lead-kicker" id="lead-category">{categoryLabel(lead.data.category)}</p>
            <h1 class="lead-title" id="lead-title"><a id="lead-title-link" href={leadHref}>{leadParts.before}{leadParts.word && <em>{leadParts.word}</em>}{leadParts.after}</a></h1>
            <p class="lead-readtime"><span id="lead-reading-time">{readMinutesFor(lead)}</span> min de lecture</p>
            <p class="lead-byline">
              <span class="lead-avatar" id="lead-avatar" aria-hidden="true">{outletCount(lead.data) || 'G'}</span>
              <span><strong id="lead-source">{coverageLabel(lead.data)}</strong> · <time id="lead-date" datetime={lead.data.pubDate.toISOString()}>{leadDate}</time></span>
            </p>
            {leadStories.length > 1 && (
              <div class="lead-pagination" role="group" aria-label="Choisir l'article à la une">
                {leadStories.map((story, index) => (
                  <button
                    class:list={['lead-page-button', index === 0 && 'is-active']}
                    type="button"
                    aria-label={`Afficher l'article ${index + 1} : ${story.data.title}`}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-lead-slide
                    data-title={story.data.title}
                    data-summary={story.data.summary}
                    data-why={story.data.whyItMatters}
                    data-source={coverageLabel(story.data)}
                    data-outlets={outletCount(story.data) || 'G'}
                    data-sources={sourcesJson(story)}
                    data-category={categoryLabel(story.data.category)}
                    data-href={pathFor(`/article/${story.id}/`)}
                    data-image={imageFor(story)}
                    data-alt={story.data.imageUrl ? `Photo liée à l'article : ${story.data.title}` : `Illustration de la rubrique ${categoryLabel(story.data.category)}`}
                    data-date={story.data.pubDate.toISOString()}
                    data-date-label={new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(story.data.pubDate)}
                    data-reading-time={readMinutesFor(story)}
                    data-audio-text={spokenFor(story)}
                    data-audio-src={audioFor(story) || undefined}
                    data-credit={creditFor(story)}
                  >{index + 1}</button>
                ))}
              </div>
            )}
            <div class="lead-actions">
              <div id="lead-audio-wrapper"><AudioPlayer text={spokenFor(lead)} slug={lead.id} label="Écouter l'article" /></div>
              <button class="button" type="button" data-sources-open>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                Transparence &amp; sources
              </button>
            </div>
          </div>
        </article>

        {nextStory && (
          <section class="next-story" aria-labelledby="next-story-title">
            <p class="next-story-label">À SUIVRE</p>
            <a class="next-story-card" href={pathFor(`/article/${nextStory.id}/`)}>
              <span class="next-story-photo"><img src={imageFor(nextStory)} alt="" width="240" height="150" loading="lazy" /></span>
              <span class="next-story-copy">
                <strong id="next-story-title">{nextStory.data.title}</strong>
                <span class="next-story-meta">{readMinutesFor(nextStory)} min de lecture · {coverageLabel(nextStory.data)}</span>
                {nextStory.data.imageUrl && <span class="next-story-credit">{creditFor(nextStory)}</span>}
              </span>
            </a>
          </section>
        )}
      </div>

      {feed.length > 0 && (
        <aside class="home-side" aria-label="Autres articles à la une">
          {feed.map((item, index) => (
            <article class:list={['side-card', index === 0 ? 'side-card-featured' : 'side-card-compact']}>
              <a class="side-thumb" href={item.href} tabindex="-1" aria-hidden="true"><img src={item.image} alt="" width="640" height="400" loading="lazy" decoding="async" /></a>
              <div class="side-copy">
                <h2 class="side-title"><a href={item.href}>{item.title}</a></h2>
                {index === 0 && <p class="side-summary">{item.summary}</p>}
                <p class="side-meta">{item.time}</p>
                {item.credit && <p class="side-credit">{item.credit}</p>}
              </div>
            </article>
          ))}
        </aside>
      )}
    </section>

    <dialog class="sources-modal" id="sources-modal" aria-labelledby="sources-title">
      <div class="sources-head">
        <h2 id="sources-title">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          Transparence &amp; sources
        </h2>
        <button class="icon-button" type="button" data-sources-close aria-label="Fermer la fiche"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      </div>
      <p class="sources-article" id="sources-article">Sujet : {lead.data.title}</p>
      <div class="sources-method"><strong>Comment Greise recoupe</strong><p>Greise rapproche les articles de médias différents qui traitent du même événement, indique combien de médias le rapportent et renvoie vers chaque article. Les titres et extraits appartiennent à leurs éditeurs ; seuls les articles originaux font foi.</p></div>
      <span class="sources-label">Médias qui rapportent ce sujet</span>
      <ul class="sources-list" id="sources-list">
        {storySources(lead.data).map((ref) => <li class="source-item"><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.name} : {ref.title || lead.data.title} ↗</a></li>)}
        {storySources(lead.data).length === 0 && <li class="source-item"><span>Dossier rédigé par Greise.</span></li>}
      </ul>
      <button class="button button-primary sources-close" type="button" data-sources-close>Fermer la fiche</button>
    </dialog>
  ) : (
    <section class="container section"><div class="empty-state">Les prochains articles arriveront bientôt. Revenez nous lire.</div></section>
  )}

  {liveStories.length > 0 && (
    <section class="container live-stories" aria-labelledby="live-title">
      <div class="live-stories-head">
        <h2 id="live-title"><span class="live-dot" aria-hidden="true"></span>À la minute</h2>
        <span class="live-updated">Mis à jour à <time data-built={new Date().toISOString()}>{builtAt}</time></span>
      </div>
      <div class="story-rail" role="list">
        <a class="story-tile story-tile-live" role="listitem" href={pathFor('/en-bref/')}>
          <span class="story-live-pill"><span class="live-dot" aria-hidden="true"></span>EN DIRECT</span>
          <strong>L'essentiel du jour en une minute</strong>
          <span class="story-sub">Les sujets les plus recoupés</span>
        </a>
        {liveStories.map((story) => (
          <a class="story-tile" role="listitem" href={pathFor(`/article/${story.id}/`)}>
            <img src={imageFor(story)} alt="" width="360" height="640" loading="lazy" decoding="async" />
            <span class="story-shade" aria-hidden="true"></span>
            <span class="story-top"><span class="story-time" data-ago={(story.data.updatedDate || story.data.pubDate).toISOString()}>{dayClock.format(story.data.updatedDate || story.data.pubDate)}</span></span>
            <span class="story-bottom">
              <small>{categoryLabel(story.data.category)}</small>
              <strong>{story.data.title}</strong>
              <span class="story-sub">{coverageLabel(story.data)}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container section recommended-section" aria-labelledby="recommended-title" data-recommended-section hidden>
    <div class="section-heading"><h2 id="recommended-title">Pour vous</h2><p>Une sélection construite à partir des rubriques que vous suivez.</p></div>
    <div class="recommended-list" data-recommended-list></div>
    <p class="recommended-empty" data-recommended-empty>Suivez une rubrique depuis une carte d'actualité pour personnaliser votre fil.</p>
  </section>

  <section class="container section feed-section" id="tous-les-articles" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">Fil d'actualité</h2><p id="latest-description">Réagissez et commentez directement sous chaque sujet.</p></div>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    {shown.length ? (
      <div class="feed" id="article-grid">
        {shown.map((article, index) => {
          const slugId = article.id;
          const isStory = article.data.kind !== 'repère';
          const count = outletCount(article.data);
          return (
            <article
              class="post"
              data-page-item
              data-index={index}
              data-lead-duplicate={article.id === lead?.id ? 'true' : undefined}
              data-article-card
              data-slug={slugId}
              data-category={article.data.category}
              data-href={pathFor(`/article/${slugId}/`)}
              data-image={imageFor(article)}
              data-title={article.data.title}
              data-summary={article.data.summary}
            >
              <header class="post-head">
                <span class="post-avatar" aria-hidden="true">{isStory ? count || 'G' : 'G'}</span>
                <div class="post-id">
                  <strong>{isStory ? coverageLabel(article.data) : 'Dossier Greise'}</strong>
                  <span class="post-sub"><time datetime={(article.data.updatedDate || article.data.pubDate).toISOString()} data-ago={(article.data.updatedDate || article.data.pubDate).toISOString()}>{dayClock.format(article.data.updatedDate || article.data.pubDate)}</time> · <a href={pathFor(`/categorie/${article.data.category}/`)}>{categoryLabel(article.data.category)}</a></span>
                </div>
              </header>
              <h3 class="post-title"><a href={pathFor(`/article/${slugId}/`)}>{article.data.title}</a></h3>
              {article.data.summary && <p class="post-summary">{article.data.summary}</p>}
              <a class="post-media" href={pathFor(`/article/${slugId}/`)} tabindex="-1" aria-hidden="true"><img src={imageFor(article)} alt="" width="1200" height="675" loading="lazy" decoding="async" /></a>
              {article.data.imageUrl && <p class="post-credit">{creditFor(article)}</p>}
              <p class="post-origin">{isStory ? `Sources : ${outletNames(article.data, 3)}` : 'Rédigé par Greise'}</p>
              <div class="post-stats"><span data-like-count></span><span class="post-stats-right"><button type="button" class="post-link" data-toggle-comments tabindex="-1" aria-hidden="true"><span data-comment-count>0 commentaire</span></button></span></div>
              <div class="post-actions" role="group" aria-label="Actions sur ce sujet">
                <button type="button" class="post-action" data-like-post aria-pressed="false">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
                  J'aime
                </button>
                <button type="button" class="post-action" data-toggle-comments aria-expanded="false">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  Commenter
                </button>
                <button type="button" class="post-action" data-share-post data-url={pathFor(`/article/${slugId}/`)}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
                  Partager
                </button>
              </div>
              <div class="post-comments" hidden>
                <div class="comments-app" data-comments data-lazy data-slug={slugId} data-configured={String(configured)} data-url={BACKEND.url} data-key={BACKEND.anonKey}></div>
              </div>
            </article>
          );
        })}
      </div>
    ) : <div class="empty-state">Les nouvelles publications de Greise s'afficheront ici.</div>}
    <p class="empty-state search-empty" id="search-empty" hidden>Aucun article ne correspond à votre recherche.</p>
    {shown.length > 6 && <div class="load-more-wrap"><button class="button" type="button" id="load-more">Voir la suite du fil</button></div>}
  </section>

  <section class="container section" aria-labelledby="debat-title">
    <div class="debate-panel">
      <div class="debate-head">
        <div class="debate-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div><h2 id="debat-title">L'Espace Débat des Lecteurs</h2><p>Des échanges pour encourager la nuance et le respect réciproque. Un commentaire à signaler ? Écrivez-nous.</p></div>
      </div>
      <div class="debate-card">
        <div class="debate-card-top"><div class="debate-author"><span class="debate-avatar" aria-hidden="true">G</span><div><strong>La rédaction Greise</strong><span class="debate-author-sub">Modération</span></div></div><span class="debate-badge">Contribution constructive</span></div>
        <p class="debate-quote">« Chaque article de Greise renvoie à sa source originale. Une simple adresse email suffit pour réagir, apporter un éclairage ou contester avec des arguments. Vos commentaires sont publics et modérés selon notre politique éditoriale. »</p>
      </div>
      <div class="debate-cta"><span>Ouvrez n'importe quel article pour commenter avec votre compte lecteur.</span><a class="button button-primary" href="#tous-les-articles">Aller au fil et commenter</a></div>
    </div>
  </section>

  <script>
    import { emphasizeParts } from '../lib/utils';
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-page-item]'));
    const loadMore = document.querySelector<HTMLButtonElement>('#load-more');
    const searchInput = document.querySelector<HTMLInputElement>('#greise-search');
    const heroGrid = document.querySelector<HTMLElement>('.hero-grid');
    const searchStatus = document.querySelector<HTMLElement>('#search-status');
    const searchEmpty = document.querySelector<HTMLElement>('#search-empty');
    const latestTitle = document.querySelector<HTMLElement>('#latest-title');
    const latestDescription = document.querySelector<HTMLElement>('#latest-description');
    let visible = 6;
    let matchingCards = cards;
    let activeQuery = new URLSearchParams(location.search).get('q')?.trim() || '';
    if (searchInput && activeQuery) searchInput.value = activeQuery;

    const updateCardVisibility = () => {
      cards.forEach((card) => { card.hidden = true; });
      matchingCards.slice(0, visible).forEach((card) => { card.hidden = false; });
      if (loadMore) loadMore.hidden = matchingCards.length <= visible;
      if (searchEmpty) searchEmpty.hidden = matchingCards.length > 0;
    };
    const applySearch = (value = searchInput?.value || '') => {
      activeQuery = value.trim().toLocaleLowerCase('fr');
      matchingCards = cards.filter((card) => {
        if (!activeQuery && card.dataset.leadDuplicate === 'true') return false;
        return !activeQuery || card.innerText.toLocaleLowerCase('fr').includes(activeQuery);
      });
      visible = 6;
      if (heroGrid) heroGrid.hidden = Boolean(activeQuery);
      if (latestTitle) latestTitle.textContent = activeQuery ? `Résultats pour « ${value.trim()} »` : "Fil d'actualité";
      if (latestDescription) latestDescription.textContent = activeQuery ? `${matchingCards.length} résultat${matchingCards.length > 1 ? 's' : ''} dans les publications Greise.` : "Réagissez et commentez directement sous chaque sujet.";
      if (searchStatus) searchStatus.textContent = activeQuery ? `${matchingCards.length} article${matchingCards.length > 1 ? 's' : ''} trouvé${matchingCards.length > 1 ? 's' : ''}.` : '';
      updateCardVisibility();
    };
    applySearch(activeQuery);
    searchInput?.addEventListener('input', () => applySearch());
    loadMore?.addEventListener('click', () => { visible += 6; updateCardVisibility(); });

    const slides = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lead-slide]'));
    const leadImageElement = document.querySelector<HTMLImageElement>('#lead-image');
    const leadImageLink = document.querySelector<HTMLAnchorElement>('#lead-image-link');
    const leadTitleLink = document.querySelector<HTMLAnchorElement>('#lead-title-link');
    const leadSummary = document.querySelector<HTMLElement>('#lead-summary');
    const leadWhy = document.querySelector<HTMLElement>('#lead-why');
    const leadCategory = document.querySelector<HTMLElement>('#lead-category');
    const leadSource = document.querySelector<HTMLElement>('#lead-source');
    const leadAvatar = document.querySelector<HTMLElement>('#lead-avatar');
    const leadDate = document.querySelector<HTMLTimeElement>('#lead-date');
    const leadReadingTime = document.querySelector<HTMLElement>('#lead-reading-time');
    const leadCredit = document.querySelector<HTMLElement>('#lead-credit');
    const leadAudio = document.querySelector<HTMLElement>('#lead-audio-wrapper');
    const sourceArticle = document.querySelector<HTMLElement>('#sources-article');
    const sourcesList = document.querySelector<HTMLElement>('#sources-list');
    const showLead = (button: HTMLButtonElement) => {
      const data = button.dataset;
      if (!data.title || !data.href || !data.image) return;
      if (leadImageElement) { leadImageElement.src = data.image; leadImageElement.alt = data.alt || ''; }
      if (leadImageLink) { leadImageLink.href = data.href; leadImageLink.setAttribute('aria-label', `Ouvrir l'article : ${data.title}`); }
      if (leadTitleLink) {
        leadTitleLink.href = data.href;
        const parts = emphasizeParts(data.title);
        const nodes: Node[] = [document.createTextNode(parts.before)];
        if (parts.word) { const em = document.createElement('em'); em.textContent = parts.word; nodes.push(em); }
        nodes.push(document.createTextNode(parts.after));
        leadTitleLink.replaceChildren(...nodes);
      }
      if (leadSummary) leadSummary.textContent = data.summary || '';
      if (leadWhy) { const strong = leadWhy.querySelector('strong'); leadWhy.replaceChildren(); if (strong) leadWhy.append(strong); leadWhy.append(document.createTextNode(data.why || '')); }
      if (leadCategory) leadCategory.textContent = data.category || '';
      if (leadSource) leadSource.textContent = data.source || '';
      if (leadAvatar) leadAvatar.textContent = data.outlets || 'G';
      if (leadDate) { leadDate.textContent = data.dateLabel || ''; leadDate.dateTime = data.date || ''; }
      if (leadReadingTime) leadReadingTime.textContent = data.readingTime || '';
      if (leadCredit) { leadCredit.textContent = data.credit || ''; leadCredit.hidden = !data.credit; }
      const audioButton = leadAudio?.querySelector<HTMLButtonElement>('[data-audio]');
      if (audioButton) {
        if (audioButton.dataset.state === 'playing' || audioButton.dataset.state === 'paused') {
          window.speechSynthesis?.cancel();
          const audioFile = leadAudio?.querySelector<HTMLAudioElement>('audio');
          if (audioFile) { audioFile.pause(); audioFile.currentTime = 0; }
          audioButton.dataset.state = 'idle';
          audioButton.setAttribute('aria-pressed', 'false');
        }
        audioButton.dataset.audioText = data.audioText || '';
        if (data.audioSrc) audioButton.dataset.audioSrc = data.audioSrc;
        else delete audioButton.dataset.audioSrc;
        const audioFile = leadAudio?.querySelector<HTMLAudioElement>('audio');
        if (audioFile) {
          if (data.audioSrc) audioFile.src = data.audioSrc;
          else audioFile.removeAttribute('src');
          audioFile.load();
        }
      }
      if (sourceArticle) sourceArticle.textContent = `Sujet : ${data.title}`;
      if (sourcesList) {
        let refs: Array<{ name: string; url: string; title: string }> = [];
        try { refs = JSON.parse(data.sources || '[]'); } catch {}
        const items = refs.map((ref) => {
          const li = document.createElement('li');
          li.className = 'source-item';
          const link = document.createElement('a');
          link.href = ref.url; link.target = '_blank'; link.rel = 'noopener noreferrer';
          link.textContent = `${ref.name} : ${ref.title} ↗`;
          li.append(link);
          return li;
        });
        sourcesList.replaceChildren(...items);
      }
      slides.forEach((item) => { const selected = item === button; item.classList.toggle('is-active', selected); item.setAttribute('aria-pressed', String(selected)); });
    };
    slides.forEach((slide) => slide.addEventListener('click', () => showLead(slide)));

    const posts = Array.from(document.querySelectorAll<HTMLElement>('.post'));
    const agoText = (iso: string) => {
      const s = (Date.now() - new Date(iso).getTime()) / 1000;
      if (!isFinite(s) || s < 0) return '';
      if (s < 90) return "à l'instant";
      if (s < 3600) return `il y a ${Math.floor(s / 60)} min`;
      if (s < 86400) return `il y a ${Math.floor(s / 3600)} h`;
      if (s < 7 * 86400) return `il y a ${Math.floor(s / 86400)} j`;
      return '';
    };
    const refreshAgo = () => document.querySelectorAll<HTMLElement>('[data-ago]').forEach((el) => { const t = agoText(el.dataset.ago || ''); if (t) el.textContent = t; });
    refreshAgo();
    window.setInterval(refreshAgo, 60000);
    const builtTime = document.querySelector<HTMLElement>('[data-built]');
    if (builtTime?.dataset.built) { const t = agoText(builtTime.dataset.built); if (t) { builtTime.parentElement!.textContent = `Mis à jour ${t}`; } }

    // Défilement infini du fil : le bouton se déclenche seul quand il arrive à l'écran.
    if (loadMore && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting) && !loadMore.hidden) loadMore.click(); }, { rootMargin: '600px 0px' }).observe(loadMore);
    }

    // Commentaires en ligne, comme sur un réseau social : le bloc s'ouvre sous le sujet.
    const mountComments = (post: HTMLElement) => {
      const panel = post.querySelector<HTMLElement>('.post-comments');
      const root = panel?.querySelector<HTMLElement>('[data-comments]');
      const mount = (window as any).greiseMountComments;
      if (root && typeof mount === 'function') mount(root);
      return { panel, root };
    };
    const toggleComments = (post: HTMLElement, forceOpen = false) => {
      const { panel } = mountComments(post);
      if (!panel) return;
      const open = forceOpen ? true : panel.hidden;
      panel.hidden = !open;
      post.querySelectorAll<HTMLElement>('button[data-toggle-comments]').forEach((b) => b.setAttribute('aria-expanded', String(open)));
      if (open) panel.querySelector<HTMLTextAreaElement>('textarea')?.focus({ preventScroll: false });
    };
    posts.forEach((post) => {
      post.querySelectorAll<HTMLElement>('[data-toggle-comments]').forEach((b) => b.addEventListener('click', () => toggleComments(post)));
      post.querySelector<HTMLElement>('[data-share-post]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLElement;
        const url = new URL(button.dataset.url || location.pathname, location.origin).toString();
        const title = post.dataset.title || document.title;
        try {
          if (navigator.share) await navigator.share({ title, url });
          else { await navigator.clipboard.writeText(url); button.lastChild!.textContent = ' Lien copié'; window.setTimeout(() => { button.lastChild!.textContent = ' Partager'; }, 2000); }
        } catch {}
      });
    });

    // Compteurs et « J'aime » des sujets (Supabase), chargés une fois que le fil est visible.
    const feedRoot = document.querySelector<HTMLElement>('#article-grid');
    const sample = feedRoot?.querySelector<HTMLElement>('[data-comments]');
    const plural = (n: number, one: string, many: string) => `${n} ${n > 1 ? many : one}`;
    let feedClient: any = null;
    let feedUser: any = null;
    const refreshStats = async () => {
      if (!feedClient) return;
      const slugs = posts.map((p) => p.dataset.slug || '').filter(Boolean);
      const [c, r] = await Promise.all([
        feedClient.from('comments').select('article_slug').in('article_slug', slugs),
        feedClient.from('article_reactions').select('article_slug, user_id').in('article_slug', slugs),
      ]);
      const comments: Record<string, number> = {};
      const likes: Record<string, number> = {};
      const mine: Record<string, boolean> = {};
      (c.data || []).forEach((row: any) => { comments[row.article_slug] = (comments[row.article_slug] || 0) + 1; });
      (r.data || []).forEach((row: any) => { likes[row.article_slug] = (likes[row.article_slug] || 0) + 1; if (feedUser && row.user_id === feedUser.id) mine[row.article_slug] = true; });
      posts.forEach((post) => {
        const slug = post.dataset.slug || '';
        const cc = post.querySelector<HTMLElement>('[data-comment-count]');
        const lc = post.querySelector<HTMLElement>('[data-like-count]');
        if (cc) cc.textContent = plural(comments[slug] || 0, 'commentaire', 'commentaires');
        if (lc) lc.textContent = likes[slug] ? plural(likes[slug], "mention J'aime", "mentions J'aime") : '';
        const btn = post.querySelector<HTMLElement>('[data-like-post]');
        btn?.setAttribute('aria-pressed', String(Boolean(mine[slug])));
        post.querySelector<HTMLElement>('button[data-toggle-comments][aria-hidden]')?.removeAttribute('tabindex');
      });
    };
    const startStats = async () => {
      const getClient = (window as any).greiseGetClient;
      if (!sample || sample.dataset.configured !== 'true' || typeof getClient !== 'function') return;
      try {
        feedClient = await getClient(sample.dataset.url, sample.dataset.key);
        const session = await feedClient.auth.getSession();
        feedUser = session.data?.session?.user || null;
        feedClient.auth.onAuthStateChange((_e: string, s: any) => { feedUser = s?.user || null; refreshStats(); });
        refreshStats();
      } catch {}
    };
    window.addEventListener('load', startStats);
    posts.forEach((post) => {
      post.querySelector<HTMLElement>('[data-like-post]')?.addEventListener('click', async () => {
        const slug = post.dataset.slug || '';
        if (!feedClient) { toggleComments(post, true); return; }
        if (!feedUser) {
          toggleComments(post, true);
          const root = post.querySelector<HTMLElement>('[data-comments]') as any;
          root?.__requireAuth?.("Indiquez votre adresse email pour réagir à ce sujet.");
          return;
        }
        const pressed = post.querySelector<HTMLElement>('[data-like-post]')?.getAttribute('aria-pressed') === 'true';
        if (pressed) await feedClient.from('article_reactions').delete().eq('article_slug', slug).eq('user_id', feedUser.id);
        else await feedClient.from('article_reactions').upsert({ article_slug: slug, user_id: feedUser.id, reaction_type: 'approve' });
        refreshStats();
      });
    });

    const recommendationSection = document.querySelector<HTMLElement>('[data-recommended-section]');
    const recommendationList = document.querySelector<HTMLElement>('[data-recommended-list]');
    const recommendationEmpty = document.querySelector<HTMLElement>('[data-recommended-empty]');
    const renderRecommendations = () => {
      if (!recommendationSection || !recommendationList) return;
      let followed: string[] = [];
      try { followed = JSON.parse(localStorage.getItem('greise-followed-categories') || '[]'); } catch {}
      recommendationSection.hidden = !followed.length;
      recommendationList.replaceChildren();
      const matches = Array.from(document.querySelectorAll<HTMLElement>('[data-article-card]')).filter((card) => followed.includes(card.dataset.category || '')).slice(0, 4);
      if (recommendationEmpty) recommendationEmpty.hidden = matches.length > 0;
      matches.forEach((card) => {
        const link = document.createElement('a'); link.className = 'recommended-card'; link.href = card.dataset.href || '#';
        const image = document.createElement('img'); image.src = card.dataset.image || ''; image.alt = ''; image.loading = 'lazy';
        const copy = document.createElement('span'); copy.className = 'recommended-copy';
        const category = document.createElement('small'); category.textContent = card.dataset.category || 'Actualité';
        const title = document.createElement('strong'); title.textContent = card.dataset.title || '';
        const summary = document.createElement('span'); summary.textContent = card.dataset.summary || '';
        copy.append(category, title, summary); link.append(image, copy); recommendationList.append(link);
      });
    };
    renderRecommendations();
    window.addEventListener('greise:preferences-changed', renderRecommendations);

    const modal = document.querySelector<HTMLDialogElement>('#sources-modal');
    document.querySelectorAll<HTMLButtonElement>('[data-sources-open]').forEach((openButton) => openButton.addEventListener('click', () => modal?.showModal()));
    modal?.querySelectorAll<HTMLButtonElement>('[data-sources-close]').forEach((closeButton) => closeButton.addEventListener('click', () => modal?.close()));
    modal?.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
  </script>
  <script is:inline src={pathFor('/comments.js')} defer></script>
</BaseLayout>
