---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories, categoryLabel, pathFor, readingTime } from '../lib/utils';
const [editorial, rss] = await Promise.all([getCollection('articles'), getCollection('rssArticles')]);
const articles = [...editorial, ...rss].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const photoStories = articles.filter((article) => article.data.generatedBy === 'rss' && article.data.imageUrl);
const selected: typeof articles = [];
const selectedIds = new Set<string>();
for (const article of [...photoStories, ...articles]) {
  if (!selectedIds.has(article.id)) { selected.push(article); selectedIds.add(article.id); }
  if (selected.length === 4) break;
}
const leadStories = selected;
const leadStory = leadStories[0] ?? articles[0];
const sideStories = leadStories.slice(1, 4);
const nextStory = articles.find((article) => article.id !== leadStory?.id && !sideStories.some((side) => side.id === article.id)) ?? sideStories[0] ?? articles.find((article) => article.id !== leadStory?.id);
const imageFor = (article: (typeof articles)[number]) => article.data.imageUrl || pathFor(article.data.image || '/images/repere.svg');
const textFor = (article: (typeof articles)[number]) => `${article.data.title}. ${article.data.summary} ${article.data.whyItMatters} ${article.body || ''}`;
---
<BaseLayout title="Greise | Le monde, en clair" description="Les actualités du monde, illustrées, sourcées et racontées en français. Explorez les rubriques de Greise et lisez à votre rythme." image={leadStory ? (leadStory.data.imageUrl || leadStory.data.image || '/avatar.jpg') : '/avatar.jpg'}>
  <div class="magazine-home container">
    <section class="magazine-showcase" aria-label="À la une">
      <div class="magazine-layout">
        <div class="lead-column">
          {leadStory && <article class="lead-feature" aria-labelledby="lead-title">
            <figure class="lead-figure">
              <a class="lead-image-link" id="lead-image-link" href={pathFor(`/article/${leadStory.id}/`)} tabindex="-1" aria-hidden="true">
                <img id="lead-image" src={imageFor(leadStory)} alt="" width="1400" height="1100" fetchpriority="high" decoding="async" />
              </a>
              <div class="lead-shade" aria-hidden="true"></div>
              <figcaption class="lead-credit" id="lead-credit" hidden>{leadStory.data.imageUrl ? `Photo : ${leadStory.data.source}, via son flux RSS` : ''}</figcaption>
            </figure>
            <div class="lead-content">
              <p class="lead-category" id="lead-category">{categoryLabel(leadStory.data.category)}</p>
              <h1 class="lead-title" id="lead-title"><a id="lead-title-link" href={pathFor(`/article/${leadStory.id}/`)}>{leadStory.data.title}</a></h1>
              <p class="lead-summary" id="lead-summary">{leadStory.data.summary}</p>
              <p class="lead-byline"><span id="lead-source">{leadStory.data.source}</span><span aria-hidden="true">·</span><span id="lead-readtime">{readingTime(textFor(leadStory))} min de lecture</span></p>
              <div class="lead-pagination" role="group" aria-label="Choisir l’actualité à la une">
                {leadStories.map((story, index) => <button type="button" class="lead-page-number" data-lead-slide data-title={story.data.title} data-href={pathFor(`/article/${story.id}/`)} data-image={imageFor(story)} data-alt={story.data.title} data-summary={story.data.summary} data-category={categoryLabel(story.data.category)} data-source={story.data.source} data-readtime={`${readingTime(textFor(story))} min de lecture`} data-credit={story.data.imageUrl ? `Photo : ${story.data.source}, via son flux RSS` : ''} aria-label={`Afficher la une ${index + 1} : ${story.data.title}`} aria-pressed={index === 0 ? 'true' : 'false'}>{index + 1}</button>)}
              </div>
            </div>
          </article>}
          {nextStory && <article class="next-story">
            <p class="meta">À suivre</p>
            <a class="next-story-card" href={pathFor(`/article/${nextStory.id}/`)}>
              <img src={imageFor(nextStory)} alt="" width="240" height="150" loading="lazy" decoding="async" />
              <span class="next-story-copy"><span class="next-story-title">{nextStory.data.title}</span><span class="meta">{categoryLabel(nextStory.data.category)} · {readingTime(textFor(nextStory))} min</span>{nextStory.data.imageUrl && <span class="next-story-credit">Photo : {nextStory.data.source}</span>}</span>
            </a>
          </article>}
        </div>
        <aside class="story-rail" aria-label="Autres actualités à découvrir">
          {sideStories[0] && <article class="rail-feature">
            <a class="rail-photo" href={pathFor(`/article/${sideStories[0].id}/`)}>
              <img src={imageFor(sideStories[0])} alt="" width="760" height="480" loading="lazy" decoding="async" />
            </a>
            {sideStories[0].data.imageUrl && <p class="rail-credit">Photo : {sideStories[0].data.source}</p>}
            <div class="rail-feature-copy">
              <p class="rail-category">{categoryLabel(sideStories[0].data.category)}</p>
              <h2><a href={pathFor(`/article/${sideStories[0].id}/`)}>{sideStories[0].data.title}</a></h2>
              <p class="rail-summary">{sideStories[0].data.summary}</p>
              <span class="meta">{readingTime(textFor(sideStories[0]))} min de lecture</span>
            </div>
          </article>}
          {sideStories.slice(1, 3).map((story) => <article class="rail-compact">
            <a class="rail-compact-photo" href={pathFor(`/article/${story.id}/`)}><img src={imageFor(story)} alt="" width="320" height="220" loading="lazy" decoding="async" /></a>
            <div><p class="rail-category">{categoryLabel(story.data.category)}</p><h3><a href={pathFor(`/article/${story.id}/`)}>{story.data.title}</a></h3><span class="meta">{readingTime(textFor(story))} min de lecture</span>{story.data.imageUrl && <span class="rail-compact-credit">Photo : {story.data.source}</span>}</div>
          </article>)}
          {!sideStories.length && <div class="rail-empty">Les actualités illustrées de Greise apparaîtront ici.</div>}
        </aside>
      </div>
    </section>

    <section class="latest-section" id="tous-les-articles" aria-labelledby="latest-title">
      <div class="latest-heading">
        <div><p class="section-kicker">Le fil Greise</p><h2 id="latest-title">Les dernières actualités</h2></div>
        <p class="latest-description">Des sujets du monde entier, classés par rubrique et reliés à leurs sources.</p>
      </div>
      <nav class="home-category-filter" aria-label="Parcourir les catégories">
        <a href={pathFor('/')} aria-current="page">Tout</a>
        {categories.map((category) => <a href={pathFor(`/categorie/${category.slug}/`)}>{category.label}</a>)}
      </nav>
      <p class="search-status" id="search-status" aria-live="polite"></p>
      {articles.length ? <div class="magazine-feed-grid" id="magazine-feed-grid">
        {articles.map((article, index) => <div class="magazine-feed-item" data-feed-item data-index={index} data-search={`${article.data.title} ${article.data.summary} ${article.data.source} ${categoryLabel(article.data.category)}`.toLocaleLowerCase('fr')}><ArticleCard article={article} /></div>)}
      </div> : <div class="empty-state">Les prochaines actualités apparaîtront ici.</div>}
      <p class="feed-empty" id="feed-empty" hidden>Aucun article ne correspond à cette recherche.</p>
      {articles.length > 6 && <div class="load-more-wrap"><button class="button magazine-more" type="button" id="load-more">Afficher plus d’articles</button></div>}
    </section>
  </div>
  <script>
    const slides = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lead-slide]'));
    const leadImage = document.querySelector<HTMLImageElement>('#lead-image');
    const imageLink = document.querySelector<HTMLAnchorElement>('#lead-image-link');
    const titleLink = document.querySelector<HTMLAnchorElement>('#lead-title-link');
    const category = document.querySelector<HTMLElement>('#lead-category');
    const summary = document.querySelector<HTMLElement>('#lead-summary');
    const source = document.querySelector<HTMLElement>('#lead-source');
    const readtime = document.querySelector<HTMLElement>('#lead-readtime');
    const credit = document.querySelector<HTMLElement>('#lead-credit');
    slides.forEach((slide, index) => slide.addEventListener('click', () => {
      const data = slide.dataset;
      if (!data.title || !data.href || !data.image || !leadImage || !titleLink) return;
      leadImage.src = data.image;
      leadImage.alt = data.alt ?? '';
      titleLink.href = data.href;
      titleLink.textContent = data.title;
      if (imageLink) imageLink.href = data.href;
      if (category) category.textContent = data.category ?? '';
      if (summary) summary.textContent = data.summary ?? '';
      if (source) source.textContent = data.source ?? '';
      if (readtime) readtime.textContent = data.readtime ?? '';
      if (credit) { credit.textContent = data.credit ?? ''; credit.hidden = !data.credit; }
      slides.forEach((button, buttonIndex) => button.setAttribute('aria-pressed', String(index === buttonIndex)));
    }));

    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-feed-item]'));
    const moreButton = document.querySelector<HTMLButtonElement>('#load-more');
    const showcase = document.querySelector<HTMLElement>('.magazine-showcase');
    const heading = document.querySelector<HTMLElement>('#latest-title');
    const status = document.querySelector<HTMLElement>('#search-status');
    const empty = document.querySelector<HTMLElement>('#feed-empty');
    const query = new URLSearchParams(window.location.search).get('q')?.trim().toLocaleLowerCase('fr') ?? '';
    const input = document.querySelector<HTMLInputElement>('#site-search');
    if (query && input) input.value = new URLSearchParams(window.location.search).get('q') ?? '';
    if (query) {
      if (showcase) showcase.hidden = true;
      if (heading) heading.textContent = 'Résultats de recherche';
    }
    const matching = query ? items.filter((item) => (item.dataset.search ?? '').includes(query)) : items;
    let visible = query ? matching.length : Math.min(6, matching.length);
    const updateFeed = () => {
      items.forEach((item) => { item.hidden = true; });
      matching.slice(0, visible).forEach((item) => { item.hidden = false; });
      if (moreButton) moreButton.hidden = visible >= matching.length;
      if (empty) empty.hidden = matching.length !== 0;
      if (status) status.textContent = query ? `${matching.length} résultat${matching.length > 1 ? 's' : ''} pour « ${new URLSearchParams(window.location.search).get('q') ?? ''} »` : '';
    };
    updateFeed();
    moreButton?.addEventListener('click', () => { visible = Math.min(visible + 6, matching.length); updateFeed(); });
  </script>
</BaseLayout>
