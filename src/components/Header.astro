---
import { categories, pathFor } from '../lib/utils';
import SocialLinks from './SocialLinks.astro';
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={pathFor('/')} aria-label="Greise, accueil"><img class="brand-avatar" src={pathFor('/avatar.jpg')} alt="" width="36" height="36" />GREISE<span class="brand-dot">.</span></a>
    <nav class="header-nav" aria-label="Navigation principale">
      {categories.map((category) => (
        <a href={pathFor(`/categorie/${category.slug}/`)} aria-current={current.includes(`/categorie/${category.slug}`) ? 'page' : undefined}>{category.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="header-social"><SocialLinks compact={true} /></div>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="Activer le thème sombre" title="Changer le thème">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      </button>
    </div>
  </div>
</header>
