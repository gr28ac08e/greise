---
import { categories, pathFor } from '../lib/utils';
import SocialLinks from './SocialLinks.astro';
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const now = new Date();
const dateLabel = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' }).format(now);
const dateValue = now.toISOString();
const query = Astro.url.searchParams.get('q') ?? '';
---
<header class="site-header magazine-header">
  <div class="container masthead-row">
    <div class="masthead-date-menu">
      <button class="masthead-menu-button" id="menu-toggle" type="button" aria-label="Ouvrir le menu du site" aria-expanded="false" aria-controls="menu-panel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <time class="masthead-date" datetime={dateValue}>{dateLabel}</time>
    </div>
    <a class="masthead-brand" href={pathFor('/')} aria-label="Greise, accueil">
      <img src={pathFor('/avatar.jpg')} alt="" width="36" height="36" />
      <span>GREISE<span class="masthead-brand-dot">.</span></span>
    </a>
    <div class="masthead-actions">
      <form class="masthead-search" role="search" action={pathFor('/')} method="get">
        <label class="visually-hidden" for="site-search">Rechercher sur Greise</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"/><path d="m15.5 15.5 4.2 4.2"/></svg>
        <input id="site-search" type="search" name="q" value={query} placeholder="Rechercher" autocomplete="off" />
      </form>
      <a class="masthead-follow" href="https://tiktok.com/@gresie13" target="_blank" rel="noopener noreferrer" aria-label="Suivre Greise sur TikTok"><span class="follow-full">Suivre Greise</span><span class="follow-short">Suivre</span></a>
      <button class="icon-button masthead-theme" id="theme-toggle" type="button" aria-label="Activer le thème clair" title="Changer le thème">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      </button>
    </div>
  </div>
  <nav class="container topic-nav" aria-label="Rubriques principales">
    <a href={pathFor('/')} aria-current={current === '/' ? 'page' : undefined}>Accueil</a>
    {categories.map((category) => <a href={pathFor(`/categorie/${category.slug}/`)} aria-current={current.includes(`/categorie/${category.slug}`) ? 'page' : undefined}>{category.label}</a>)}
  </nav>
  <div class="menu-panel" id="menu-panel" hidden>
    <div class="menu-panel-inner">
      <p class="meta">Le journal Greise</p>
      <a href={pathFor('/a-propos/')}>À propos de Greise</a>
      <a href={pathFor('/contact/')}>Contact</a>
      <a href={pathFor('/politique-editoriale/')}>Politique éditoriale</a>
      <a href={pathFor('/mentions-legales/')}>Mentions légales</a>
      <div class="menu-social"><SocialLinks compact={false} /></div>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const panel = document.querySelector<HTMLElement>('#menu-panel');
  const header = document.querySelector<HTMLElement>('.magazine-header');
  const search = document.querySelector<HTMLInputElement>('#site-search');
  const closeMenu = () => {
    if (!toggle || !panel) return;
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Ouvrir le menu du site');
  };
  toggle?.addEventListener('click', () => {
    if (!panel) return;
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu du site' : 'Ouvrir le menu du site');
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  document.addEventListener('click', (event) => { if (header && event.target instanceof Node && !header.contains(event.target)) closeMenu(); });
  if (search) search.value = new URLSearchParams(window.location.search).get('q') ?? search.value;
</script>
